(deftheme github-c
  "GitHub-inspired theme for C code.")

(custom-theme-set-faces
 'github-c
 '(default ((t (:background "#FFFFFF" :foreground "#24292E"))))
 '(font-lock-comment-face ((t (:foreground "#008000"))))
 '(font-lock-string-face ((t (:foreground "#A31515"))))
 '(font-lock-keyword-face ((t (:foreground "#0000FF" :weight bold))))
 '(font-lock-type-face ((t (:foreground "#2B91AF"))))
 '(font-lock-constant-face ((t (:foreground "#0000FF"))))
 '(font-lock-preprocessor-face ((t (:foreground "#0000FF"))))
 '(font-lock-function-name-face ((t (:foreground "#000000"))))
 '(font-lock-builtin-face ((t (:foreground "#2B91AF"))))
 '(font-lock-variable-name-face ((t (:foreground "#24292E")))))
